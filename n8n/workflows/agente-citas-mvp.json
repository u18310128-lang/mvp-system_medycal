        "jsonBody": "{\"celular\": \"={{ $('Normalizar entrada').item.json.celular }}\", \"cita_id\": {cita_id}, \"fecha\": \"{fecha}\", \"hora\": \"{hora}\", \"medico\": \"{medico}\"}",
        "placeholderDefinitions": { "values": [ { "name": "cita_id", "description": "Identificador numérico de la cita propia", "type": "number" }, { "name": "fecha", "description": "Fecha YYYY-MM-DD", "type": "string" }, { "name": "hora", "description": "Hora HH:MM", "type": "string" }, { "name": "medico", "description": "Profesional elegido, si corresponde", "type": "string" } ] },
        "optimizeResponse": false
      },
      "id": "b2000000-0000-4000-8000-000000000010",
      "name": "Reprogramar cita",
