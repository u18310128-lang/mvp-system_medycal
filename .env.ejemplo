# =====================================================================
#  PLANTILLA — NO ESCRIBAS VALORES REALES EN ESTE ARCHIVO
#
#  Este archivo SÍ se versiona: va al repositorio y lo ve cualquiera que
#  clone el proyecto. Solo documenta QUÉ variables hacen falta.
#
#  Tus valores reales van en .env, que está en .gitignore y no se sube:
#
#      copy .env.ejemplo .env
#      notepad .env            <-- acá sí, los valores reales
#
#  Si escribiste un secreto acá por error, no alcanza con borrarlo:
#  hay que darlo de baja y generar uno nuevo.
# =====================================================================

# ---------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------
PGHOST=localhost
PGPORT=5433
PGDATABASE=peru-ruso
PGUSER=postgres
PGPASSWORD=

# ---------------------------------------------------------------------
# Agente conversacional
# ---------------------------------------------------------------------

# Clave de la API de OpenAI. Sin ella el canal funciona igual, con el
# modelo simulado (reglas por palabras clave), que es la condición de
# control del experimento.
OPENAI_API_KEY=

# Modelo a usar. Se deja como variable porque comparar modelos es parte
# del diseño experimental y no debería exigir tocar el código.
AGENTE_MODELO=gpt-4o-mini

# Clave de servicio que autentica al proceso que llama a /api/agente/*.
# Se genera con scripts/crear-credenciales.ts o insertándola a mano en la
# tabla clave_servicio. En la base se guarda solo su resumen SHA-256.
CLAVE_SERVICIO=

# Base de la API de citas que consulta el agente. Se deja configurable
# para poder mover el agente a otro proceso sin tocar código.
AGENTE_API_URL=http://localhost:3000

# `http` (a través de la API, como corresponde al diseño) o `directo`
# (acceso en proceso), que sirve para medir cuánto cuesta esa frontera.
AGENTE_AGENDA=http

# ---------------------------------------------------------------------
# Servidor
# ---------------------------------------------------------------------
PORT=3000
BASE_URL=http://localhost:3000
