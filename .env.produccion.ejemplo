# =====================================================================
#  PLANTILLA DE PRODUCCIÓN — NO ESCRIBAS VALORES REALES ACÁ
#
#  En el servidor:
#      cp .env.produccion.ejemplo .env
#      nano .env               <-- los valores reales van ahí
#      chmod 600 .env          <-- que solo lo lea tu usuario
#
#  El archivo .env está en .gitignore y nunca se sube al repositorio.
# =====================================================================

# ---------------------------------------------------------------------
# Dominio
# ---------------------------------------------------------------------
# Sin https:// ni barra final. Tiene que apuntar por DNS a este servidor.
DOMINIO=citas.tudominio.pe

# Con https://. La usa el enlace que le llega al paciente por WhatsApp.
BASE_URL=https://citas.tudominio.pe

# ---------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------
PGDATABASE=peru_ruso
PGUSER=peruruso

# Generala, no la inventes:   openssl rand -base64 32
# No reutilices la de desarrollo.
PGPASSWORD=

# ---------------------------------------------------------------------
# Agente conversacional
# ---------------------------------------------------------------------
# https://platform.openai.com/api-keys — necesita saldo en la cuenta.
# Si queda vacía, el canal funciona con el modelo simulado (reglas).
OPENAI_API_KEY=
AGENTE_MODELO=gpt-4o-mini
AGENTE_AGENDA=http

# Autentica a n8n contra la aplicación. Se genera con:
#     docker compose -f docker-compose.produccion.yml exec app \
#       npx tsx scripts/crear-credenciales.ts
CLAVE_SERVICIO=

# ---------------------------------------------------------------------
# n8n
# ---------------------------------------------------------------------
N8N_USUARIO=admin

# openssl rand -base64 24
N8N_PASSWORD=

# openssl rand -hex 32
# Cifra las credenciales guardadas dentro de n8n. Si la perdés o la
# cambiás, hay que volver a cargar todas las conexiones del flujo.
N8N_ENCRYPTION_KEY=

# ---------------------------------------------------------------------
# WhatsApp Cloud API (Meta)
# ---------------------------------------------------------------------
# Se cargan como credenciales dentro de n8n, no acá, salvo que el flujo
# las tome del entorno. Requieren verificación de empresa aprobada.
# META_ACCESS_TOKEN=
# META_PHONE_NUMBER_ID=
# META_VERIFY_TOKEN=
